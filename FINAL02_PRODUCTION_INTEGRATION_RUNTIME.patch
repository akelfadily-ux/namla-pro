+  readonly sourceColonies: readonly ColonyId[];
+  readonly autoResolvable: boolean;
+  readonly resolved: boolean;
+  readonly resolutionStrategy: string | null;
+  readonly resultFingerprint: string | null;
+  readonly detail: string;
